# ─── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────
# Leave VITE_API_BASE_URL empty locally — Vite's dev proxy (vite.config.js)
# forwards /api, /oauth2, /login/oauth2 to http://localhost:8080 automatically.
# Setting it would double-prefix the base URL.
VITE_API_BASE_URL=
